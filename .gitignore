node_modules/
# package-lock.json IS tracked (it used to be ignored). Two dependencies is
# still two supply chains: without a lockfile every install resolved
# `fast-xml-parser` afresh, so what production parsed hostile feed XML with was
# whatever npm picked that day, and `npm audit` had nothing stable to judge.
# CI runs `npm ci`, which requires the lockfile and installs it exactly.
.env
.env.local
.env.*.local
.vercel
*.log
.DS_Store
tests/out/
