{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/radar", "schedule": "0 5 * * *" },
    { "path": "/api/radar?urgentOnly=1", "schedule": "*/15 * * * *" },
    { "path": "/api/report?period=week&send=1", "schedule": "0 6 * * 1" },
    { "path": "/api/geo?send=1", "schedule": "0 7 * * 1" },
    { "path": "/api/alerts?notify=1", "schedule": "45 5 * * *" }
  ],
  "rewrites": [
    { "source": "/stats", "destination": "/stats.html" },
    { "source": "/context", "destination": "/context.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/reports", "destination": "/reports.html" },
    { "source": "/auth/verify", "destination": "/api/verify" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'none'; manifest-src 'self'; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'" }
      ]
    }
  ],
  "functions": {
    "api/radar.js": { "maxDuration": 60 }
  }
}
